rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ---- Who is an admin.
    // Signed in, and the sign-in token carries the custom claim admin: true.
    // Only a script with the Admin SDK can set that claim; no app can.
    // get() with a default: a token without the claim is simply not admin.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.get('admin', false) == true;
    }

    // ---- Car limits. They must stay equal to the constants in
    // lib/features/fleet/domain/car_limits.dart. A unit test compares them
    // (test/rules/car_rules_limits_test.dart).
    function carNameMaxLength() { return 40; }
    function carMinYear() { return 1990; }
    function carMaxSeats() { return 9; }
    function carMaxPricePerDay() { return 2000; }
    function carMaxEngineSize() { return 8; }
    function carDescriptionMaxLength() { return 1000; }
    function carMaxPhotos() { return 10; }
    function carPhotoMaxLength() { return 500; }

    // { ka, ru, en }: all three, each a text with no space at either end.
    function isValidCarDescription(d) {
      return d is map
        && d.keys().hasOnly(['ka', 'ru', 'en'])
        && d.keys().hasAll(['ka', 'ru', 'en'])
        && isTrimmedText(d.ka, 1, carDescriptionMaxLength())
        && isTrimmedText(d.ru, 1, carDescriptionMaxLength())
        && isTrimmedText(d.en, 1, carDescriptionMaxLength());
    }

    // An https address without spaces and with a dot in it.
    function isCarPhoto(p) {
      return p is string
        && p.size() <= carPhotoMaxLength()
        && p.matches('^https://[^\\s]+\\.[^\\s]+$');
    }

    // Rules have no loops, so each possible position is checked by hand.
    // The number of lines must equal carMaxPhotos().
    function isValidCarPhotos(p) {
      return p is list
        && p.size() <= carMaxPhotos()
        && p.toSet().size() == p.size()
        && (p.size() < 1 || isCarPhoto(p[0]))
        && (p.size() < 2 || isCarPhoto(p[1]))
        && (p.size() < 3 || isCarPhoto(p[2]))
        && (p.size() < 4 || isCarPhoto(p[3]))
        && (p.size() < 5 || isCarPhoto(p[4]))
        && (p.size() < 6 || isCarPhoto(p[5]))
        && (p.size() < 7 || isCarPhoto(p[6]))
        && (p.size() < 8 || isCarPhoto(p[7]))
        && (p.size() < 9 || isCarPhoto(p[8]))
        && (p.size() < 10 || isCarPhoto(p[9]));
    }

    // The whole car document. engineSize is the only optional field.
    function isValidCar(car) {
      return car.keys().hasOnly([
               'brand', 'model', 'year', 'drivetrain', 'transmission',
               'fuelType', 'seats', 'engineSize', 'pricePerDay',
               'description', 'photos', 'active'])
        && car.keys().hasAll([
               'brand', 'model', 'year', 'drivetrain', 'transmission',
               'fuelType', 'seats', 'pricePerDay', 'description', 'photos',
               'active'])
        && isTrimmedText(car.brand, 1, carNameMaxLength())
        && isTrimmedText(car.model, 1, carNameMaxLength())
        && car.year is int
        && car.year >= carMinYear()
        && car.year <= request.time.year() + 1
        && car.drivetrain in ['fwd', 'rwd', 'awd']
        && car.transmission in ['automatic', 'manual']
        && car.fuelType in ['petrol', 'diesel', 'hybrid', 'electric']
        && car.seats is int
        && car.seats >= 1
        && car.seats <= carMaxSeats()
        && (!('engineSize' in car)
             || (car.engineSize is number
                  && car.engineSize > 0
                  && car.engineSize <= carMaxEngineSize()))
        && car.pricePerDay is number
        && car.pricePerDay > 0
        && car.pricePerDay <= carMaxPricePerDay()
        && isValidCarDescription(car.description)
        && isValidCarPhotos(car.photos)
        && car.active is bool;
    }

    // Hiding or showing a car: "active" is the only field that changes, and
    // it is a bool afterwards. This must work for EVERY stored car, also an
    // old one that would not pass isValidCar, so it does not check the rest.
    function isOnlyActiveChange() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['active'])
        && request.resource.data.active is bool;
    }

    // Public catalog: anyone can read a car that is active.
    // A list query must itself filter on active == true, or it is denied.
    // An admin can read every car, also a hidden one: the bookings list must
    // show the car of an old booking.
    // An admin can add and change a car. The whole document is checked on
    // every write, except when only "active" changes (hide or show).
    // Nobody can delete a car: "remove" is active == false.
    match /cars/{carId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create: if isAdmin()
        && carId.matches('^[A-Za-z0-9_-]{1,128}$')
        && isValidCar(request.resource.data);
      allow update: if isAdmin()
        && (isValidCar(request.resource.data) || isOnlyActiveChange());
      allow delete: if false;
    }

    // Settings (extras prices, locations, later company info): anyone can
    // read; nobody can write from an app. Admin writes are added in Phase 6.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if false;
    }

    // ---- Booking limits. They must stay equal to the constants in
    // lib/features/booking/domain/booking_limits.dart. A unit test compares
    // them (test/rules/booking_rules_limits_test.dart).
    function nameMinLength() { return 2; }
    function nameMaxLength() { return 100; }
    function emailMaxLength() { return 254; }
    function otherLocationMaxLength() { return 200; }
    function notesMaxLength() { return 500; }
    function maxRentalDays() { return 365; }
    function maxTotalPrice() { return 1000000; }

    // A text of min..max characters with no space at either end.
    function isTrimmedText(value, min, max) {
      return value is string
        && value.size() >= min
        && value.size() <= max
        && value.matches('^\\S([\\s\\S]*\\S)?$');
    }

    function isValidCustomer(c) {
      return c is map
        && c.keys().hasOnly(
             ['fullName', 'phone', 'whatsapp', 'telegram', 'email'])
        && c.keys().hasAll(
             ['fullName', 'phone', 'whatsapp', 'telegram', 'email'])
        && isTrimmedText(c.fullName, nameMinLength(), nameMaxLength())
        // "+", a first digit 1-9, 8 to 15 digits in total
        // (bookingPhoneMinDigits and bookingPhoneMaxDigits, each minus 1).
        && c.phone is string
        && c.phone.matches('^\\+[1-9][0-9]{7,14}$')
        && c.whatsapp is bool
        && c.telegram is bool
        // No spaces, one "@", a domain with at least one dot.
        && c.email is string
        && c.email.size() <= emailMaxLength()
        && c.email.matches('^[^@\\s]+@[^@\\s.]+(\\.[^@\\s.]+)+$');
    }

    // { id } for a fixed place, { id: 'other', text } for a free text.
    // The rules cannot look an id up in settings/locations, so they only
    // check its shape (the same pattern as locationIdPattern in
    // lib/core/models/booking_location.dart).
    function isValidLocation(l) {
      return l is map
        && l.keys().hasAll(['id'])
        && l.id is string
        && (l.id == 'other'
             ? l.keys().hasOnly(['id', 'text'])
               && l.keys().hasAll(['text'])
               && isTrimmedText(l.text, 1, otherLocationMaxLength())
             : l.keys().hasOnly(['id'])
               && l.id.matches('^[A-Za-z][A-Za-z0-9_-]{0,63}$'));
    }

    // One document read per booking attempt. There is no separate exists():
    // for a car that does not exist, get() gives no document, reading
    // ".data" of it is an error, and an error refuses the request.
    function isActiveCar(carId) {
      return carId is string
        && carId.matches('^[A-Za-z0-9_-]{1,128}$')
        && get(/databases/$(database)/documents/cars/$(carId))
             .data.active == true;
    }

    function isValidNewBooking(b) {
      return b.keys().hasOnly([
               'customer', 'carId', 'pickupDateTime', 'dropoffDateTime',
               'pickupLocation', 'dropoffLocation', 'extras', 'notes',
               'totalPrice', 'language', 'status', 'createdAt'])
        && b.keys().hasAll([
               'customer', 'carId', 'pickupDateTime', 'dropoffDateTime',
               'pickupLocation', 'dropoffLocation', 'extras', 'notes',
               'totalPrice', 'language', 'status', 'createdAt'])
        && isValidCustomer(b.customer)
        && isActiveCar(b.carId)
        && b.pickupDateTime is timestamp
        && b.dropoffDateTime is timestamp
        && b.pickupDateTime > request.time
        && b.dropoffDateTime > b.pickupDateTime
        && b.dropoffDateTime
             <= b.pickupDateTime + duration.value(maxRentalDays(), 'd')
        && isValidLocation(b.pickupLocation)
        && isValidLocation(b.dropoffLocation)
        && b.extras is list
        && b.extras.size() <= 4
        && b.extras.hasOnly(
             ['snowChains', 'childSeat', 'infantSeat', 'boosterSeat'])
        && b.extras.toSet().size() == b.extras.size()
        && b.notes is string
        && b.notes.size() <= notesMaxLength()
        && b.totalPrice is number
        && b.totalPrice >= 0
        && b.totalPrice <= maxTotalPrice()
        && b.language in ['ka', 'ru', 'en']
        && b.status == 'new'
        && b.createdAt == request.time;
    }

    // ---- Bookings written by an admin (Phase 3).
    //
    // An admin may create a booking by hand and change every field of an
    // existing one. The document is still checked for its shape, with the
    // same limits as a customer request. What differs from a customer:
    // - any of the four statuses, not only "new";
    // - createdBy (the staff name) is allowed;
    // - the pickup may be in the past (an old booking is corrected);
    // - the car must exist but may be hidden.
    // createdAt is checked by the caller: server time on create, unchanged
    // on update. expireAt is still not accepted from any app.

    // The car exists; it may be hidden. One document read.
    function isExistingCar(carId) {
      return carId is string
        && carId.matches('^[A-Za-z0-9_-]{1,128}$')
        && exists(/databases/$(database)/documents/cars/$(carId));
    }

    function isValidAdminBooking(a) {
      return a.keys().hasOnly([
               'customer', 'carId', 'pickupDateTime', 'dropoffDateTime',
               'pickupLocation', 'dropoffLocation', 'extras', 'notes',
               'totalPrice', 'language', 'status', 'createdAt',
               'createdBy'])
        && a.keys().hasAll([
               'customer', 'carId', 'pickupDateTime', 'dropoffDateTime',
               'pickupLocation', 'dropoffLocation', 'extras', 'notes',
               'totalPrice', 'language', 'status', 'createdAt'])
        && isValidCustomer(a.customer)
        && isExistingCar(a.carId)
        && a.pickupDateTime is timestamp
        && a.dropoffDateTime is timestamp
        && a.dropoffDateTime > a.pickupDateTime
        && a.dropoffDateTime
             <= a.pickupDateTime + duration.value(maxRentalDays(), 'd')
        && isValidLocation(a.pickupLocation)
        && isValidLocation(a.dropoffLocation)
        && a.extras is list
        && a.extras.size() <= 4
        && a.extras.hasOnly(
             ['snowChains', 'childSeat', 'infantSeat', 'boosterSeat'])
        && a.extras.toSet().size() == a.extras.size()
        && a.notes is string
        && a.notes.size() <= notesMaxLength()
        && a.totalPrice is number
        && a.totalPrice >= 0
        && a.totalPrice <= maxTotalPrice()
        && a.language in ['ka', 'ru', 'en']
        && a.status in ['new', 'pending', 'confirmed', 'cancelled']
        && a.createdAt is timestamp
        // The staff name is optional; when present, 1 to 100 characters.
        && (!('createdBy' in a)
             || isTrimmedText(a.createdBy, 1, nameMaxLength()));
    }

    // Bookings.
    // - Anyone may create a valid customer request (unchanged).
    // - An admin may also create a booking by hand, read and list all
    //   bookings, change one, and delete one.
    // - Nobody else can read, change or delete a booking.
    match /bookings/{bookingId} {
      allow create: if isValidNewBooking(request.resource.data)
        || (isAdmin()
             && isValidAdminBooking(request.resource.data)
             && request.resource.data.createdAt == request.time);
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && isValidAdminBooking(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    // Everything else is denied, also for an admin. This includes the
    // "mail" collection, which no app may ever read or write.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
