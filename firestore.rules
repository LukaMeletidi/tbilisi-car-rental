rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Public catalog: anyone can read a car that is active.
    // A list query must itself filter on active == true, or it is denied.
    // Nobody can write yet; admin writes are added in Phase 3.
    match /cars/{carId} {
      allow read: if resource.data.active == true;
      allow write: if false;
    }

    // Settings (extras prices, locations, later company info): anyone can
    // read; nobody can write from an app. Admin writes are added in Phase 3.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if false;
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
