{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "tbilisi-car-rental",
          "appId": "1:717629199640:android:fde82c221d3ab8146dba6d",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "tbilisi-car-rental",
          "configurations": {
            "android": "1:717629199640:android:fde82c221d3ab8146dba6d",
            "ios": "1:717629199640:ios:e711261170747e0c6dba6d",
            "web": "1:717629199640:web:a5e9ab7d52a7a7306dba6d"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "build/web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "headers": [
      {
        "source": "**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/*.@(png|jpg|svg|otf|ttf|woff|woff2)",
        "headers": [{ "key": "Cache-Control", "value": "max-age=86400" }]
      }
    ]
  },
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
