  "faqPageHeading": "Answers to popular customer questions",
  "@faqPageHeading": {
    "description": "FAQ page: the heading above the questions."
  },
  "faq1Question": "What documents are required to rent a car?",
  "@faq1Question": {
    "description": "FAQ page: question 1."
  },
  "faq1Answer": "To rent a car, you will need a valid driver's license, passport and international driver's license (if your country is not included in the agreed list).",
  "@faq1Answer": {
    "description": "FAQ page: the answer to question 1, shown when it is opened."
  },
  "faq2Question": "Where is the best place to refuel in Georgia?",
  "@faq2Question": {
    "description": "FAQ page: question 2."
  },
  "faq2Answer": "On each five-kilometer stretch of road you will find small gas stations, and larger ones are located 10-15 km away. The vast majority of stations operate around the clock. Various types of fuel are available to you, including diesel, 92nd, 95th and 98th gasoline.",
  "@faq2Answer": {
    "description": "FAQ page: the answer to question 2, shown when it is opened."
  },
  "faq3Question": "How do I get a rental car?",
  "@faq3Question": {
    "description": "FAQ page: question 3."
  },
  "faq3Answer": "After successful booking, you can pick up the car at the specified location. Our representative will provide you with a car, check the necessary documents and tell you about the features of use.",
  "@faq3Answer": {
    "description": "FAQ page: the answer to question 3, shown when it is opened."
  },
  "faq4Question": "Have plans changed: the cancellation process and related payments?",
  "@faq4Question": {
    "description": "FAQ page: question 4."
  },
  "faq4Answer": "If your plans have changed, you can cancel your reservation by contacting our support service. Depending on the date and reason for cancellation, certain payments may apply.",
  "@faq4Answer": {
    "description": "FAQ page: the answer to question 4, shown when it is opened."
  },
  "faq5Question": "The impact of flight cancellation or postponement on car booking?",
  "@faq5Question": {
    "description": "FAQ page: question 5."
  },
  "faq5Answer": "If your flight is cancelled or rescheduled, please contact us as soon as possible. We will try to adapt your order according to the new schedule.",
  "@faq5Answer": {
    "description": "FAQ page: the answer to question 5, shown when it is opened."
  },
  "faq6Question": "What expenses can I incur when renting a car?",
  "@faq6Question": {
    "description": "FAQ page: question 6."
  },
  "faq6Answer": "Expenses may include fuel, payment of fines for traffic violations and additional services if they are not included in the main package.",
  "@faq6Answer": {
    "description": "FAQ page: the answer to question 6, shown when it is opened."
  },
  "faq7Question": "What happens if you break the lease?",
  "@faq7Question": {
    "description": "FAQ page: question 7."
  },
  "faq7Answer": "Violation of the lease agreement may result in unilateral termination of the agreement, fines under the agreement and legal consequences in accordance with the legislation of Georgia.",
  "@faq7Answer": {
    "description": "FAQ page: the answer to question 7, shown when it is opened."
  },
  "faq8Question": "The procedure for paying for a car rental: when and how is it performed?",
  "@faq8Question": {
    "description": "FAQ page: question 8."
  },
  "faq8Answer": "The rent is paid at the time of signing the contract. We accept payments by cards, online transfers, and cryptocurrency — in any currency.",
  "@faq8Answer": {
    "description": "FAQ page: the answer to question 8, shown when it is opened."
  },
  "faq9Question": "How should cars be returned after the rental?",
  "@faq9Question": {
    "description": "FAQ page: question 9."
  },
  "faq9Answer": "It is necessary to return the car in the same condition in which it was received, with the same fuel level. Our cars are available for rent in a clean condition.",
  "@faq9Answer": {
    "description": "FAQ page: the answer to question 9, shown when it is opened."
  },
  "faq10Question": "What is the amount of the prepayment?",
  "@faq10Question": {
    "description": "FAQ page: question 10."
  },
  "faq10Answer": "The amount of the prepayment depends on the date of booking, the rental period and the selected car model. Details are discussed personally at the time of booking.",
  "@faq10Answer": {
    "description": "FAQ page: the answer to question 10, shown when it is opened."
  },
